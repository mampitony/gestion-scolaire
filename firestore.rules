rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function aUnProfil() {
      return request.auth != null
        && exists(/databases/$(database)/documents/utilisateurs/$(request.auth.uid));
    }
    function profil() {
      return get(/databases/$(database)/documents/utilisateurs/$(request.auth.uid)).data;
    }
    function connecte() {
      return aUnProfil() && profil().actif == true && profil().get('enAttente', false) == false
        && (profil().get('historiqueVersion', 0) == 0
            || request.auth.token.get('email', '').lower() == profil().email);
    }
    function role() { return profil().role; }
    function gestion() { return connecte() && role() in ['admin', 'directeur', 'secretaire']; }

    match /utilisateurs/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || (connecte() && role() in ['admin', 'directeur']));
      allow create: if (connecte() && role() == 'admin')
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['nom', 'email', 'role', 'actif', 'enAttente'])
            && request.resource.data.nom is string
            && request.resource.data.nom.size() > 0
            && request.resource.data.nom.size() <= 120
            && request.resource.data.email is string
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == 'secretaire'
            && request.resource.data.actif == false
            && request.resource.data.enAttente == true);
      allow update: if connecte() && role() == 'admin'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'historiqueVersion']);
      allow delete: if connecte() && role() == 'admin' && resource.data.role != 'admin';
    }

    match /journalAdmin/{id} {
      allow read: if connecte() && role() == 'admin'
        && resource.data.adminUid == request.auth.uid;
      allow create: if connecte() && role() == 'admin'
        && request.resource.data.keys().hasOnly(['adminUid', 'action', 'date', 'version'])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 1000
        && request.resource.data.date == request.time
        && request.resource.data.version == profil().get('historiqueVersion', 0);
    }

    match /classes/{id} {
      allow read: if connecte();
      allow write: if gestion();
    }

    match /matieres/{id} {
      allow read: if connecte();
      allow write: if gestion();
    }

    // Un dossier élève n'est jamais supprimé (RG09) : on change son statut.
    match /eleves/{id} {
      allow read: if connecte();
      allow create, update: if gestion();
      allow delete: if false;
    }

    // Tarifs de l'année : lecture pour tous les comptes actifs, écriture admin/directeur.
    match /parametres/{id} {
      allow read: if connecte();
      allow write: if connecte() && role() in ['admin', 'directeur'];
    }

    // Paiements : jamais modifiés ni supprimés (traçabilité des reçus).
    match /paiements/{id} {
      allow read: if connecte() && role() in ['admin', 'directeur', 'secretaire', 'caissier'];
      allow create: if connecte() && role() in ['admin', 'directeur', 'caissier'];
      allow update, delete: if false;
    }

    // Notes : un enseignant ne lit et ne modifie que ses propres notes.
    match /notes/{id} {
      allow read: if gestion()
        || (connecte() && role() == 'enseignant' && resource.data.enseignantUid == request.auth.uid);
      allow create: if (connecte() && role() in ['admin', 'directeur'])
        || (connecte() && role() == 'enseignant' && request.resource.data.enseignantUid == request.auth.uid);
      allow update: if (connecte() && role() in ['admin', 'directeur'])
        || (connecte() && role() == 'enseignant'
            && resource.data.enseignantUid == request.auth.uid
            && request.resource.data.enseignantUid == request.auth.uid);
      allow delete: if connecte() && role() in ['admin', 'directeur'];
    }

    // Absences et retards : saisis par le surveillant ou la gestion.
    match /absences/{id} {
      allow read, create: if connecte() && role() in ['admin', 'directeur', 'secretaire', 'surveillant'];
      allow update, delete: if gestion();
    }

    match /compteurs/{id} {
      allow read, write: if gestion() || (connecte() && role() == 'caissier' && id == 'recu');
    }
  }
}
